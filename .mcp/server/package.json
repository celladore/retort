{
  "name": "retort-mcp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --target=node22 --outfile=dist/index.js --format=cjs --external:fs --external:path --external:@modelcontextprotocol/sdk --external:express --external:js-yaml --external:zod",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "packageManager": "pnpm@9.15.0",
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "express": "^4.21.1",
    "js-yaml": "^4.1.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.9.0",
    "esbuild": "^0.27.4",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
