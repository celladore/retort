%% /project-status Data Flow
%% Shows how the command aggregates data from multiple sources

flowchart LR
    subgraph "Data Sources"
        OJ[orchestrator.json]
        AB[AGENT_BACKLOG.md]
        TF[".claude/state/tasks/*.json"]
        EL[events.log]
        GL["git log --oneline"]
    end

    subgraph "/project-status"
        PS[Read + Aggregate]
    end

    subgraph "Output"
        MD[Markdown Report]
        JSON[JSON Report]
    end

    OJ --> PS
    AB --> PS
    TF --> PS
    EL --> PS
    GL --> PS
    PS -->|"--format markdown"| MD
    PS -->|"--format json"| JSON
